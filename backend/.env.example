# Backend Environment Template

# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=imss_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5120000000

# API
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
